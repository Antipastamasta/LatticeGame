{
  "appId": "com.lonelightgaming.lattice",
  "appName": "Lattice",
  "webDir": "www",
  "backgroundColor": "#f6f7f5",
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false,
    "backgroundColor": "#f6f7f5"
  },
  "android": {
    "backgroundColor": "#f6f7f5"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 300,
      "launchAutoHide": true,
      "backgroundColor": "#f6f7f5",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "overlaysWebView": true
    }
  }
}
